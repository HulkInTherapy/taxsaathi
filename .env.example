# Copy this file to `.env` (same folder) and fill in the keys. `.env` is gitignored.
# Both providers expose an OpenAI-compatible API with tool calling.

# Primary LLM: NVIDIA NIM (free, phone verification) — https://build.nvidia.com
NVIDIA_API_KEY=

# Fallback LLM: OpenRouter free models — https://openrouter.ai
OPENROUTER_API_KEY=

# Which provider the agents use first: nvidia | openrouter | ollama
TAXOT_LLM_PROVIDER=nvidia
