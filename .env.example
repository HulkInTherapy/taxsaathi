# Copy this file to `.env` (same folder) and fill in the keys. `.env` is gitignored.
# All providers expose an OpenAI-compatible API with tool calling. Providers without a key are skipped.

# Primary LLM: NVIDIA NIM (free, phone verification) — https://build.nvidia.com
NVIDIA_API_KEY=

# Fallbacks, tried in this order (the verifier tries Regolo first)
REGOLO_API_KEY=        # https://regolo.ai (30-day trial, ~1M tokens/day, no card)
GROQ_API_KEY=          # https://console.groq.com (free, no card)
GEMINI_API_KEY=        # https://aistudio.google.com — use a project WITHOUT billing for the free tier
OPENROUTER_API_KEY=    # https://openrouter.ai (free models: 50 requests/day)

# Which provider the agents use first: nvidia | regolo | groq | gemini | openrouter | ollama
TAXOT_LLM_PROVIDER=nvidia
